page {
  title: "Hello"
}

state name = "world"

{style
  body { font-family: system-ui; display: grid; place-items: center; min-height: 100vh; margin: 0; background: #0b0a12; color: #efeaff; }
  h1 { color: #9a7dff; }
}

render {
  <div>
    <h1>Hello, {name}!</h1>
    <p>You are editing real Luna source in the browser. Press Run to compile.</p>
  </div>
}
